---
import BlogPosts from "./BlogPosts.svelte";
import { feedUrl, parseFeed, profileUrl } from "../data/blog";
import type { Post } from "../data/blog";

/**
 * A snapshot is fetched at build time so the section renders complete in the
 * static HTML, with no JS and no layout shift. The island then refetches on
 * view, which is what picks up new posts between deploys. This needs the
 * feed to allow cross-origin reads, see FEED_HEADERS in the Omicron frontend.
 */
let seed: Post[] = [];

try {
  const res = await fetch(feedUrl, { signal: AbortSignal.timeout(10000) });
  if (res.ok) seed = parseFeed(await res.text());
  else console.warn(`[blog] feed returned ${res.status}`);
} catch (err) {
  console.warn("[blog] could not fetch the feed at build time", err);
}
---

<section id="blog" class="border-dark-10 border-t py-16">
  <div class="mb-8 flex items-baseline justify-between gap-4">
    <h2
      class="text-muted-foreground text-xs font-semibold uppercase tracking-[0.12em]"
    >
      Blog
    </h2>

    <a
      href={profileUrl}
      target="_blank"
      rel="noreferrer noopener"
      class="text-muted-foreground hover:text-foreground rounded-button text-sm transition-colors"
    >
      All posts
    </a>
  </div>

  <BlogPosts
    client:visible
    feedUrl={feedUrl}
    profileUrl={profileUrl}
    seed={seed}
  />
</section>
