---
import Button from "./ui/Button.svelte";
import MobileNav from "./MobileNav.svelte";
import { nav, site } from "../data/site";
---

<header class="bg-background/80 sticky top-0 z-40 backdrop-blur-md">
  <div
    class="mx-auto flex h-16 w-full max-w-4xl items-center gap-3 px-4 sm:gap-6 sm:px-6"
  >
    <a
      href="/"
      class="hover:text-foreground-alt shrink-0 font-serif text-xl leading-none transition-colors"
      aria-label={site.name}
    >
      {site.short}
    </a>

    <!-- below sm the links do not fit beside the wordmark at any sensible size,
         so they move into the hamburger panel instead of being clipped -->
    <nav
      class="hidden min-w-0 items-center gap-0.5 overflow-x-auto [scrollbar-width:none] sm:flex sm:gap-1 [&::-webkit-scrollbar]:hidden"
      aria-label="Sections"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-foreground-alt hover:bg-dark-10 hover:text-foreground rounded-button shrink-0 px-2 py-1.5 text-sm font-medium transition-colors sm:px-2.5"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto hidden sm:block">
      <Button href={`mailto:${site.email}`} size="sm" variant="outline">
        Get in touch
      </Button>
    </div>

    <div class="ml-auto sm:hidden">
      <MobileNav client:load />
    </div>
  </div>
</header>
