---
import Button from "./ui/Button.svelte";
import { nav, site } from "../data/site";
---

<header
  class="border-dark-10 bg-background/80 sticky top-0 z-40 border-b backdrop-blur-md"
>
  <div
    class="mx-auto flex h-16 w-full max-w-4xl items-center gap-3 px-4 sm:gap-6 sm:px-6"
  >
    <a
      href="/"
      class="hover:text-foreground-alt shrink-0 font-serif text-xl leading-none transition-colors"
      aria-label={site.name}
    >
      {site.short}
    </a>

    <!-- scrolls rather than pushing the page wide, so narrow phones keep the
         logo and the section headings on the same left edge. While the get in
         touch button is hidden it also sits against the right gutter, so the
         bar is not left packed with a growing gap on the right. -->
    <nav
      class="ml-auto flex min-w-0 items-center gap-0.5 overflow-x-auto [scrollbar-width:none] sm:ml-0 sm:gap-1 [&::-webkit-scrollbar]:hidden"
      aria-label="Sections"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-foreground-alt hover:bg-dark-10 hover:text-foreground rounded-button shrink-0 px-2 py-1.5 text-sm font-medium transition-colors sm:px-2.5"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto hidden sm:block">
      <Button href={`mailto:${site.email}`} size="sm" variant="outline">
        Get in touch
      </Button>
    </div>
  </div>
</header>
