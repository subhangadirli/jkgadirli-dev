---
import Mail from "@lucide/svelte/icons/mail";
import Button from "./ui/Button.svelte";
import CopyEmail from "./CopyEmail.svelte";
import { site } from "../data/site";
---

<section id="contact" class="border-dark-10 border-t py-16">
  <h2
    class="text-muted-foreground mb-8 text-xs font-semibold uppercase tracking-[0.12em]"
  >
    Contact
  </h2>

  <div
    class="rounded-card border-border-card bg-background-alt shadow-card border p-6 text-center sm:p-8 md:text-left"
  >
    <p class="text-xl font-semibold tracking-[-0.02em]">
      Have something in mind?
    </p>

    <p
      class="text-muted-foreground mx-auto mt-3 max-w-[52ch] text-[15px] leading-relaxed md:mx-0"
    >
      Open to freelance work, collaborations and open-source contributions. The
      fastest way to reach me is email.
    </p>

    <!-- the address can outgrow a narrow phone, so it wraps rather than
         stretching the card -->
    <p class="text-foreground-alt mt-6 break-all font-mono text-sm">
      {site.email}
    </p>

    <!-- full width while stacked, so the two buttons read as one block instead
         of two ragged edges -->
    <div
      class="mt-6 flex flex-col items-stretch gap-3 md:flex-row md:flex-wrap md:items-center"
    >
      <Button href={`mailto:${site.email}`} class="w-full md:w-auto">
        <Mail class="size-[18px]" />
        Send an email
      </Button>
      <CopyEmail client:visible class="w-full md:w-auto" />
    </div>
  </div>
</section>
