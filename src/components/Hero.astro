---
import MapPin from "@lucide/svelte/icons/map-pin";
import FileText from "@lucide/svelte/icons/file-text";
import Mail from "@lucide/svelte/icons/mail";
import Avatar from "./ui/Avatar.svelte";
import Button from "./ui/Button.svelte";
import SocialLinks from "./SocialLinks.astro";
import { site } from "../data/site";
---

<section class="pb-16 pt-20 sm:pb-20 sm:pt-28">
  <div class="mb-8 flex items-center gap-4">
    <Avatar
      client:load
      src="/images/pp.jpg"
      alt={site.name}
      fallback={site.short}
    />

    <span
      class="border-dark-10 bg-background-alt text-muted-foreground rounded-input inline-flex items-center gap-1.5 border px-2.5 py-1 text-xs font-medium"
    >
      <MapPin class="size-3.5" />
      {site.location}
    </span>
  </div>

  <h1
    class="text-4xl font-semibold leading-[1.05] tracking-[-0.03em] sm:text-5xl"
  >
    {site.name}
  </h1>

  <p class="text-foreground-alt mt-4 text-lg font-medium">
    {site.role}
  </p>

  <p
    class="text-muted-foreground mt-4 max-w-[54ch] text-[15px] leading-relaxed"
  >
    Computer Science student at Azerbaijan Technical University. I build
    fediverse tools, Linux desktop apps and developer tooling, mostly in
    TypeScript and Python.
  </p>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <Button href={site.resume} target="_blank" rel="noreferrer noopener">
      <FileText class="size-[18px]" />
      Resume
    </Button>
    <Button href={`mailto:${site.email}`} variant="outline">
      <Mail class="size-[18px]" />
      Email me
    </Button>
  </div>

  <div class="mt-10">
    <SocialLinks />
  </div>
</section>
