---
import { education, skillGroups } from "../data/site";
---

<section id="about" class="border-dark-10 border-t py-16">
  <h2
    class="text-muted-foreground mb-8 text-xs font-semibold uppercase tracking-[0.12em]"
  >
    About
  </h2>

  <div class="grid gap-10 md:grid-cols-[1.1fr_0.9fr] md:items-start md:gap-12">
    <div class="flex flex-col gap-8">
      <div>
        <p class="text-xl font-semibold tracking-[-0.02em]">
          Code as craft. Part engineering, part philosophy.
        </p>

        <p class="text-muted-foreground mt-4 text-[15px] leading-relaxed">
          It started in middle school with my first computer, which led me to
          Linux, and coding stopped being a skill and became a way of thinking.
        </p>

        <p class="text-muted-foreground mt-3 text-[15px] leading-relaxed">
          I work across the whole stack, backend logic through to frontend design,
          turning ideas into things people can actually use. Away from the editor I
          read philosophy and write about where technology, creativity and human
          thought meet.
        </p>
      </div>

      <div
        class="rounded-card border-muted bg-background-alt shadow-card w-full border p-4"
      >
        <p class="text-sm font-semibold">Education</p>
        <ul class="mt-4 flex select-none flex-col gap-4">
          {
            education.map((item) => (
              <li class="flex items-start gap-3">
                <span class="border-dark-10 bg-background rounded-input text-muted-foreground mt-0.5 inline-flex size-8 shrink-0 items-center justify-center border">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="size-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
                    <path d="M22 10v6" />
                    <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
                  </svg>
                </span>
                <div>
                  <p class="text-sm font-semibold">{item.title}</p>
                  <p class="text-muted-foreground text-sm">
                    {item.org} &middot; {item.period}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="rounded-card border-muted bg-background-alt shadow-card w-full border p-4"
    >
      <p class="text-sm font-semibold">Toolkit</p>
      <div class="mt-4 flex select-none flex-col gap-3.5">
        {
          skillGroups.map((group) => (
            <div>
              <p class="text-muted-foreground mb-1.5 text-xs font-semibold uppercase tracking-wide">
                {group.label}
              </p>
              <ul class="flex flex-wrap gap-1.5">
                {group.items.map((skill) => (
                  <li class="border-dark-10 bg-background rounded-input border px-2 py-0.5 text-[13px] font-medium">
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
