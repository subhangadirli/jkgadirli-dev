---
import { nav, site } from "../data/site";
---

<a class="skip" href="#main">Skip to content</a>

<header class="wrap">
  <nav class="bar glass" aria-label="Primary">
    <a class="mark" href="#top" aria-label={`${site.name} — home`}>
      {site.short}
    </a>

    <ul class="links">
      {
        nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>

    <a class="cta" href={site.resume} target="_blank" rel="noopener">Résumé</a>
  </nav>
</header>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }

  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--bg-soft);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
  }

  .wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: clamp(0.75rem, 2vw, 1.25rem) var(--gutter);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: var(--shell);
    margin-inline: auto;
    padding: 0.5rem 0.5rem 0.5rem 1.1rem;
    border-radius: 999px;
    box-shadow: 0 10px 40px -20px rgba(0, 0, 0, 0.9);
  }

  .mark {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.6rem);
    margin-inline: auto;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  .links a {
    padding: 0.35rem 0.2rem;
    transition: color 0.25s ease;
  }

  .links a:hover {
    color: var(--ink);
  }

  .cta {
    padding: 0.5rem 1.05rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--glass-strong);
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
    transition:
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .cta:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.28);
  }

  @media (max-width: 30rem) {
    .cta {
      display: none;
    }

    .links {
      margin-left: auto;
      margin-right: 0.35rem;
    }
  }
</style>
