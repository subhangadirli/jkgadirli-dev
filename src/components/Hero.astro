---
import MapPin from "@lucide/svelte/icons/map-pin";
import FileText from "@lucide/svelte/icons/file-text";
import Mail from "@lucide/svelte/icons/mail";
import Button from "./ui/Button.svelte";
import Separator from "./ui/Separator.svelte";
import SocialLinks from "./SocialLinks.svelte";
import { site } from "../data/site";
---

<section class="pb-14 pt-14 sm:pb-16 sm:pt-20">
  <!-- text left, portrait right, centred against each other. Below md the
       portrait moves above the text, which is why the order is reversed, and
       the whole stack centres on its own axis. -->
  <div
    class="flex flex-col-reverse items-center gap-8 md:flex-row md:justify-between md:gap-14"
  >
    <div class="min-w-0 flex-1 text-center md:text-left">
      <h1
        class="text-4xl font-semibold leading-[1.05] tracking-[-0.03em] sm:text-5xl"
      >
        {site.name}
      </h1>

      <!-- role and location share one line, so the block stays a single stack -->
      <div
        class="text-foreground-alt mt-3 flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 text-lg font-medium md:justify-start"
      >
        <span>{site.role}</span>
        <!-- the dot only makes sense while both parts share a line. Between md
             and lg the portrait squeezes this column enough that the location
             wraps, which would leave the dot stranded at the end of the role. -->
        <span class="text-muted-foreground hidden lg:inline" aria-hidden="true"
          >&middot;</span
        >
        <span
          class="text-muted-foreground inline-flex items-center gap-1.5 text-base"
        >
          <MapPin class="size-4" />
          {site.location}
        </span>
      </div>

      <p
        class="text-muted-foreground mx-auto mt-5 max-w-[52ch] text-[15px] leading-relaxed md:mx-0"
      >
        Computer Science student at Azerbaijan Technical University. I build
        fediverse tools, Linux desktop apps and developer tooling, mostly in
        TypeScript and Python.
      </p>

      <!-- actions and social icons on one row, so the icons read as part of the
           same band rather than a stray group further down the page -->
      <div
        class="mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-5 md:justify-start"
      >
        <div class="flex items-center justify-center gap-3">
          <Button href={site.resume}>
            <FileText class="size-[18px]" />
            Resume
          </Button>
          <Button href={`mailto:${site.email}`} variant="outline">
            <Mail class="size-[18px]" />
            Email me
          </Button>
        </div>

        <!-- the base class sets h-full, which collapses to nothing inside a
             centred flex row, so the height and colour are forced here -->
        <Separator
          orientation="vertical"
          class="bg-border-input! hidden data-[orientation=vertical]:h-7! lg:block"
        />

        <SocialLinks client:load />
      </div>
    </div>

    <!-- a plain image, not the Bits UI Avatar: that one ships the img hidden
         and reveals it from JS, so the portrait disappeared whenever the island
         had not hydrated yet -->
    <div
      class="border-foreground size-32 shrink-0 rounded-full border p-0.5 sm:size-48"
    >
      <img
        src="/images/pp.jpeg"
        alt={site.name}
        width="192"
        height="192"
        fetchpriority="high"
        class="size-full rounded-full object-cover"
      />
    </div>
  </div>
</section>
