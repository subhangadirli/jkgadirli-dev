---
import Separator from "./ui/Separator.svelte";
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-dark-10 mt-8 border-t">
  <div
    class="text-muted-foreground mx-auto flex h-16 w-full max-w-4xl items-center gap-3 px-6 text-xs"
  >
    <span>&copy; {year} {site.name}</span>
    <Separator
      orientation="vertical"
      class="data-[orientation=vertical]:h-3.5"
    />
    <span>Built with Astro on Linux</span>
    <a
      href={site.resume}
      target="_blank"
      rel="noreferrer noopener"
      class="hover:text-foreground ml-auto transition-colors">Resume</a
    >
  </div>
</footer>
