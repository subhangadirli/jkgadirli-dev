---
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.svelte";
import { site } from "../data/site";

/** Google fetches the PDF server side, which sidesteps the
 *  Content-Disposition: attachment header GitHub sends on release assets.
 *  The encoded URL stays stable, latest always resolves to the newest file. */
const viewer = `https://drive.google.com/viewerng/viewer?embedded=true&url=${encodeURIComponent(site.resumePdf)}`;
---

<Base
  title={`Resume - ${site.title}`}
  description={`Resume of ${site.name}, ${site.role}.`}
/>
  <section class="pb-14 pt-14 sm:pb-16 sm:pt-20">
    <div
      class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <h1
          class="text-4xl font-semibold leading-[1.05] tracking-[-0.03em] sm:text-5xl"
        >
          Resume
        </h1>
        <p class="text-muted-foreground mt-3 text-[15px] leading-relaxed">
          Preview below, always the newest release. Grab a copy for keeps if
          you need one.
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-3">
        <Button
          href={site.resumePdf}
          target="_blank"
          rel="noreferrer noopener"
        >
          Download PDF
        </Button>
      </div>
    </div>

    <div
      class="rounded-card border-muted bg-background-alt shadow-card mt-8 overflow-hidden border"
    >
      <iframe
        src={viewer}
        title="Resume preview"
        class="h-[80vh] w-full"
        loading="lazy"
      ></iframe>
    </div>

    <p class="text-muted-foreground mt-4 text-sm">
      Preview not loading? Open the
      <a
        href={site.resumePdf}
        target="_blank"
        rel="noreferrer noopener"
        class="underline underline-offset-4 hover:text-foreground"
        >PDF directly</a
      >.
    </p>
  </section>
</Base>
