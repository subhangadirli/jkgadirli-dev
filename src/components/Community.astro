---
import ArrowUpRight from "@lucide/svelte/icons/arrow-up-right";
---

<section id="community" class="border-dark-10 border-t py-16">
  <h2
    class="text-muted-foreground mb-8 text-xs font-semibold uppercase tracking-[0.12em]"
  >
    Community
  </h2>

  <a
    href="https://githubcommunity.az/"
    target="_blank"
    rel="noreferrer noopener"
    class="rounded-card border-border-card bg-background-alt shadow-card hover:border-border-input-hover focus-visible:ring-dark focus-visible:ring-offset-background focus-visible:outline-hidden relative flex flex-col items-start gap-4 border p-5 transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 sm:flex-row sm:items-center"
  >
    <img
      src="/images/logos/agc-white.png"
      alt=""
      loading="lazy"
      decoding="async"
      class="h-10 w-auto shrink-0 object-contain"
    />

    <div class="min-w-0 flex-1">
      <h3 class="text-[15px] font-semibold tracking-[-0.01em]">
        Lead of the Azerbaijan GitHub Community
      </h3>
      <p class="text-muted-foreground mt-1 text-sm leading-relaxed">
        I lead the Azerbaijan GitHub Community, bringing local developers
        together around open source.
      </p>
    </div>

    <!-- pinned to the corner while the card is stacked, so the text keeps the
         full width instead of wrapping around it -->
    <ArrowUpRight
      class="text-muted-foreground absolute right-5 top-5 size-4 shrink-0 sm:static"
    />
  </a>
</section>
